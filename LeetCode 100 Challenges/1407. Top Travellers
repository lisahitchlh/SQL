/* Write a solution to report the distance traveled by each user.

Return the result table ordered by travelled_distance in descending order, 
if two or more users traveled the same distance, order them by their name in 
ascending order. */

--trying it with a subquery, 1100ms runtime performance
SELECT name, COALESCE(travelled_distance,0) AS travelled_distance
FROM Users as u
LEFT JOIN
(SELECT user_id, SUM(distance) as travelled_distance FROM Rides GROUP BY 1) as b
ON u.id = b.user_id
ORDER BY travelled_distance DESC, name ASC

-- trying it with a CTE, 990ms runtime performance
WITH distance as
(SELECT user_id, SUM(distance) as travelled_distance FROM Rides GROUP BY 1)
SELECT name, COALESCE(travelled_distance,0) AS travelled_distance
FROM Users as u
LEFT JOIN
distance as d
ON u.id = d.user_id
ORDER BY travelled_distance DESC, name ASC

