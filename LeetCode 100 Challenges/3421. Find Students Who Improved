/*

Write a solution to find the students who have shown improvement. 
A student is considered to have shown improvement
if they meet both of these conditions:

Have taken exams in the same subject on at least two different dates
Their latest score in that subject is higher than their first score
Return the result table ordered by student_id, subject in ascending order.

*/

with a as 
(SELECT 
    student_id
    , subject
    , MIN(exam_date) as earliest_date
    , MAX(exam_date) as latest_date
FROM Scores
GROUP BY student_id, subject
HAVING COUNT(exam_date) >= 2)

SELECT 
    a.student_id
    , a.subject
    , MIN(CASE WHEN earliest_date = exam_date then score END) as first_score
    , MAX(CASE WHEN latest_date = exam_date then score END) as latest_score
from a
JOIN Scores as s
ON s.student_id = a.student_id
    AND s.subject = a.subject
GROUP BY student_id, subject
HAVING latest_score > first_score
ORDER BY student_id ASC,subject ASC